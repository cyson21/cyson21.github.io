---
import { ArrowRight, ArrowUpRight, Download } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, resumeClosing, resumeHighlights } from '../data/site';
---

<BaseLayout mainClass="home-main" title="손찬양" description="Java · Spring Boot 기반의 6년 차 백엔드 개발자 손찬양의 포트폴리오입니다. API 개발·운영과 데이터 정합성 경험을 정리했습니다.">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-intro">
          <div class="hero-person">
            <img src="/media/profile.png" alt="손찬양 프로필 사진" width="112" height="112" />
            <div>
              <p class="hero-role"><span>자바 스프링부트</span><span>백엔드 개발자</span></p>
              <p class="hero-subtitle">{profile.subtitle}</p>
            </div>
          </div>
          <h1>손찬양</h1>
        </div>
        <div class="hero-lede">
          <p class="hero-statement">{profile.statement}</p>
          <ul class="hero-highlights">
            {resumeHighlights.map((item) => <li>{item}</li>)}
          </ul>
          <p class="hero-closing">{resumeClosing}</p>
        </div>
        <div class="button-row hero-actions">
          <a class="button" href="/portfolio/">통합 포트폴리오 HTML <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="button" href="/experience/">경력·이력서 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="button button--secondary" href={profile.resumePath}>PDF <Download size={17} aria-hidden="true" /></a>
          <a class="button button--text" href={profile.github} target="_blank" rel="noreferrer" aria-label="손찬양 GitHub 프로필 새 창에서 열기">GitHub <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-block: 56px 64px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .hero-inner {
    display: block;
  }

  .hero-copy {
    display: grid;
    max-width: 1080px;
    min-width: 0;
    grid-template-areas:
      "intro statement"
      ". actions";
    grid-template-columns: minmax(270px, 0.72fr) minmax(0, 1.28fr);
    gap: 16px 64px;
    align-items: start;
  }

  .hero-intro {
    display: grid;
    grid-area: intro;
    gap: 16px;
    align-content: start;
    min-width: 0;
  }

  .hero-person {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .hero-person img {
    width: 92px;
    height: 92px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(15%);
  }

  .hero-role {
    margin-bottom: 6px;
    color: var(--blue);
    font-size: var(--text-dense);
    font-weight: 780;
  }

  .hero-role span {
    display: block;
  }

  .hero-subtitle {
    color: var(--ink-soft);
    font-size: var(--text-label);
    font-weight: 680;
  }

  .hero h1 {
    font-size: var(--text-h1);
  }

  .hero-lede {
    grid-area: statement;
    display: grid;
    gap: 14px;
    max-width: min(760px, 42ic);
    min-width: 0;
  }

  .hero-statement {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-lede);
    font-weight: 720;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .hero-highlights {
    margin: 0;
    padding-left: 1.15em;
    color: var(--ink-soft);
    font-size: var(--text-body);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .hero-highlights li {
    min-width: 0;
  }

  .hero-highlights li + li {
    margin-top: 0.35em;
  }

  .hero-closing {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-dense);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .hero-actions {
    grid-area: actions;
    margin-top: 4px;
    min-width: 0;
  }

  @media (max-width: 959px) {
    .hero-copy {
      display: block;
      max-width: 800px;
      min-width: 0;
    }

    .hero-intro {
      gap: 14px;
    }

    .hero-person {
      min-width: 0;
    }

    .hero-person > div {
      min-width: 0;
    }

    .hero-lede {
      margin-top: 20px;
      max-width: none;
    }

    .hero-actions {
      margin-top: 26px;
    }

  }

  @media (max-width: 639px) {
    .hero {
      padding-block: 30px 36px;
    }

    .hero-person {
      gap: 12px;
    }

    .hero-person img {
      width: 66px;
      height: 66px;
      flex: 0 0 auto;
    }

    .hero-actions {
      margin-top: 18px;
    }

  }
</style>
