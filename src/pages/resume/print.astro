---
import { experiences, profile } from '../../data/site';
import { resumePrint } from '../../data/resume-print';
import '../../styles/career-documents.css';
const [current, previous] = experiences;
if (!current || !previous) throw new Error('두 회사의 경력이 필요합니다.');
---
<!doctype html>
<html lang="ko-KR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>손찬양 | 백엔드 개발자 이력서</title>

</head>
<body class="resume-document"><main>
  <section class="sheet" aria-label="이력서 1페이지">
    <header>
      <h1>{profile.name}</h1><p class="role">{profile.role}</p>
      <div class="contact"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>github.com/cyson21</a><a href={profile.portfolio}>cyson21.github.io</a></div>
    </header>
    <p class="introduction">{resumePrint.introduction}</p>
    <dl class="skills" aria-label="핵심 기술"><dt>핵심 기술</dt><dd>{resumePrint.coreSkills.map(line => <p>{line}</p>)}</dd></dl>
    <section class="section" aria-labelledby="career-title">
      <h2 id="career-title" class="section-title">경력</h2>
      <div class="company-heading"><h3>{current.company}</h3><time class="period">{current.period}</time></div>
      <p class="job-role">{current.role}</p><p class="company-context">{current.context}</p>
      {resumePrint.currentProjects.map(project => (
        <article class="project" data-work-case={'anchor' in project ? project.anchor : undefined}>
          <h4>{project.title}</h4>
          <ul>{project.bullets.map((bullet, index) => <li data-work-case={'relatedAnchor' in project && index === 1 ? project.relatedAnchor : undefined}>{bullet}</li>)}</ul>
        </article>
      ))}
      <p class="supporting">{resumePrint.supportingWork}</p>
    </section>
    <footer class="page-footer"><span>손찬양 · 이력서</span><span>1 / 2</span></footer>
  </section>
  <section class="sheet" aria-label="이력서 2페이지">
    <p class="continuation">손찬양 · 이력서</p>
    <section class="previous" aria-label="이전 회사 경력">
      <div class="company-heading"><h3>{previous.company}</h3><time class="period">{previous.period}</time></div>
      <p class="job-role">{previous.role}</p><p class="company-context">공공·실시간 데이터 서비스의 수집·가공부터 API 개발, 배포·운영까지 담당했습니다.</p>
      {resumePrint.previousProjects.map(project => (
        <article class="project">
          <div class="project-heading"><h4>{project.title}</h4><span class="period">{project.period}</span></div>
          {'technology' in project && <p class="technology">{project.technology}</p>}
          <ul>{project.bullets.map(bullet => <li>{bullet}</li>)}</ul>
        </article>
      ))}
      <p class="other-skills">관련 기술 · {resumePrint.otherSkills}</p>
    </section>
    <section class="education" aria-labelledby="education-title"><h2 id="education-title">학력</h2><p>서울과학기술대학교 · 영어영문학 학사 · 2018 졸업</p></section>
    <div class="document-links"><a href={new URL(profile.careerDescriptionPath, profile.portfolio).href}>경력기술서 PDF</a><a href={new URL('/portfolio/', profile.portfolio).href}>실무 사례 웹 포트폴리오</a></div>
    <footer class="page-footer"><span>손찬양 · 이력서</span><span>2 / 2</span></footer>
  </section>
</main></body>
</html>
