---
import { experiences, previousCompanyProjects, profile, professionalSummary, resumeIntro, skillGroups } from '../../data/site';
const [current, previous] = experiences;
if (!current || !previous) throw new Error('두 회사의 경력이 필요합니다.');
const printStack: readonly string[] = ['Java', 'Spring Boot', 'Spring Data JPA', 'QueryDSL', 'MySQL', 'Redis', 'ShedLock', 'Redisson', 'RabbitMQ', 'AWS EC2', 'Docker', 'JUnit', 'Testcontainers'];
---
<!doctype html>
<html lang="ko-KR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>손찬양 | 백엔드 개발자 이력서</title>
<style is:global>
*{box-sizing:border-box}html{background:#edf1f5;color:#243449;font-family:Pretendard,"Apple SD Gothic Neo","Noto Sans KR",sans-serif}body{margin:0;line-height:1.58}main{max-width:940px;margin:32px auto}.sheet{background:#fff;padding:48px 60px;margin-bottom:20px;border-top:4px solid #315d88}h1,h2,h3,p{margin:0}h1{font-size:33px;line-height:1.2;letter-spacing:-.02em}.role{font-size:16px;font-weight:650;color:#315d88;margin-top:5px}.contact{display:flex;gap:7px 22px;flex-wrap:wrap;margin-top:14px;font-size:13px}a{color:#315d88;text-underline-offset:3px}a:focus-visible{outline:3px solid #315d88;outline-offset:3px}.intro{font-size:15px;margin:24px 0 0;line-height:1.7}.section{margin-top:26px}h2{font-size:18px;padding-bottom:7px;border-bottom:1px solid #b9c6d4;margin-bottom:14px}h3{font-size:17px}.jobhead{display:flex;justify-content:space-between;gap:14px;align-items:baseline}.jobhead time,.job-role{font-size:13px;color:#5b6b7d}.job-context{margin-top:9px;color:#405267;font-size:14px}.bullets{padding-left:19px;margin:13px 0 0;font-size:14px}.bullets li{padding-left:3px;margin:0 0 10px}.bullets strong{font-weight:700;color:#243e58}.stack{font-size:13px;color:#4b5b70;margin-top:12px}.stack strong{color:#243449}.project{padding:10px 0;border-bottom:1px solid #e2e8ef;font-size:14px}.project:last-child{border:0}.project h4{margin:0 0 2px;font-size:14px;color:#243e58}.project p{margin:0}.skills{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px;font-size:13px}.skills strong{color:#315d88}.education,.links{font-size:14px}.links p{margin:5px 0}.foot{margin-top:26px;color:#6b7888;font-size:11px}
@media(max-width:640px){main{margin:0}.sheet{padding:30px 22px;margin:0 0 12px}.jobhead{display:block}.skills{grid-template-columns:1fr}.intro{font-size:15px}h1{font-size:29px}}
@media print{@page{size:A4;margin:13mm 15mm}html{background:white}main{max-width:none;margin:0}.sheet{border:0;padding:0;margin:0;break-after:page}.sheet:last-child{break-after:auto}h1{font-size:25pt}.role{font-size:11pt}.contact{font-size:9pt;margin-top:3mm}.intro{font-size:10.5pt;margin-top:5mm;line-height:1.6}.section{margin-top:5mm}h2{font-size:13pt;margin-bottom:2.5mm;padding-bottom:1.5mm}h3{font-size:11pt}.jobhead time,.job-role{font-size:9pt}.job-context,.bullets,.project,.education,.links{font-size:10.5pt}.job-context{margin-top:2mm}.bullets{margin-top:2mm;padding-left:4mm}.bullets li{margin-bottom:3mm}.stack,.skills{font-size:9pt}.stack{margin-top:2mm}.project{padding:2.5mm 0}.project h4{font-size:9.5pt}.foot{display:none}a{color:inherit;text-decoration:none}}
</style></head><body><main>
<section class="sheet" aria-label="이력서 1페이지"><header><h1>{profile.name}</h1><p class="role">{profile.role}</p><div class="contact"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>github.com/cyson21</a><a href={`${profile.portfolio}portfolio/`}>포트폴리오</a></div></header>
<p class="intro">{resumeIntro} {professionalSummary}</p>
<section class="section"><h2>경력</h2><div class="jobhead"><h3>{current.company}</h3><time>{current.period}</time></div><p class="job-role">{current.role}</p><p class="job-context">{current.context}</p>
<ul class="bullets">{current.responsibilities.map(item => <li><strong>{item.title}</strong> · {item.description}</li>)}</ul><p class="stack"><strong>주요 기술</strong> · {current.stack.filter(item => printStack.includes(item)).map(item => item === 'AWS EC2' ? 'AWS' : item).join(', ')}</p></section></section>
<section class="sheet" aria-label="이력서 2페이지"><section class="section" style="margin-top:0"><h2>이전 경력</h2><div class="jobhead"><h3>{previous.company}</h3><time>{previous.period}</time></div><p class="job-role">{previous.role}</p><p class="job-context">{previous.context}</p>
{previousCompanyProjects.map(project => <article class="project"><h4>{project.title} <span class="job-role">{project.period}</span></h4><p>{project.description}</p></article>)}
<p class="stack"><strong>주요 기술</strong> · Java, Spring Boot, Python, Pandas, PostgreSQL, MySQL, Docker</p></section>
<section class="section"><h2>기술</h2><div class="skills">{skillGroups.map(group => <div><strong>{group.label}</strong> · {group.items.join(', ')}</div>)}</div></section>
<section class="section education"><h2>학력</h2><p><strong>서울과학기술대학교</strong> · 영어영문학 학사 · 2018 졸업</p></section>
<section class="section links"><h2>상세 자료</h2><p><a href={new URL(profile.careerDescriptionPath, profile.portfolio).href}>경력기술서</a> — 회사별 담당 범위와 프로젝트 상세</p><p><a href={`${profile.portfolio}portfolio/`}>포트폴리오</a> — 실무 사례와 개인 프로젝트 구현</p></section></section></main></body></html>
