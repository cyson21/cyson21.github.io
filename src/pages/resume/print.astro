---
import { experiences, profile, professionalSummary, resumeIntro, skillGroups } from '../../data/site';
---
<!doctype html>
<html lang="ko-KR">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>손찬양 이력서</title></head>
  <body>
    <main>
      {experiences.map((experience, index) => (
        <section class={`sheet ${index === 0 ? 'sheet--first' : ''}`} aria-label={`이력서 ${index + 1}페이지`}>
          {index === 0 ? (
            <>
              <header class="masthead"><div><h1>{profile.name}</h1><p class="role-line">{profile.role}</p></div><img src="/media/profile.png" alt="손찬양 프로필 사진" width="100" height="100" /></header>
              <div class="contact-row"><a href={profile.github}>GitHub · github.com/cyson21</a><a href={`${profile.portfolio}portfolio/`}>포트폴리오 · cyson21.github.io/portfolio/</a></div>
              <section class="summary block"><strong>{resumeIntro}</strong><p>{professionalSummary}</p></section>
              <section class="core-skills block"><h2>핵심 실무 기술</h2><p>{skillGroups.flatMap(group => group.items).join(' · ')}</p></section>
            </>
          ) : <header class="page-header"><strong>{profile.name}</strong><span>{profile.role}</span></header>}
          <section class="experience block">
            <h2>{index === 0 ? '최근 경력 · 주요 기여' : '이전 경력 · 프로젝트별 기여'}</h2>
            <article class="job">
              <header><div><h3>{experience.company}</h3><p>{experience.role}</p></div><time>{experience.period}</time></header>
              <p class="context">{experience.context}</p>
              <ul class="highlight-list">{experience.responsibilities.map(item => <li><strong>{item.title}</strong><p>{item.description}</p></li>)}</ul>
            </article>
          </section>
          {index === 1 && (
            <>
              <section class="education block"><h2>학력</h2><strong>서울과학기술대학교</strong><p>영어영문학 학사 · 2018 졸업</p></section>
              <section class="document-links block"><h2>상세 자료</h2><p><a href={`${profile.portfolio}resume/career/`}>경력기술서 · 회사별 담당 범위와 기여</a></p><p><a href={`${profile.portfolio}portfolio/`}>포트폴리오 · 실무 사례와 개인 프로젝트의 공개 구현</a></p></section>
            </>
          )}
          <footer><span>손찬양 · 이력서</span><span>{index + 1} / 2</span></footer>
        </section>
      ))}
    </main>
  </body>
</html>
<style is:global>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #e7eaf0; color: #202b3b; font-family: Pretendard, "Noto Sans KR", "Apple SD Gothic Neo", Arial, sans-serif; }
  body { font-size: 10pt; line-height: 1.5; }
  a { color: inherit; text-decoration: none; }
  main { display: grid; justify-content: center; gap: 10mm; padding-block: 10mm; }
  .sheet { position: relative; width: 210mm; height: 297mm; padding: 13mm 15mm 24mm; overflow: hidden; background: #fff; break-after: page; }
  .sheet:last-child { break-after: auto; }
  h1, h2, h3, p { margin: 0; word-break: keep-all; }
  h1 { font-size: 29pt; line-height: 1.1; }
  h2 { font-size: 14pt; margin-bottom: 3mm; }
  h3 { font-size: 11pt; line-height: 1.4; }
  .block { margin-top: 5mm; }
  .masthead { display: flex; align-items: center; justify-content: space-between; }
  .masthead img { width: 23mm; height: 23mm; object-fit: cover; border: 0.25mm solid #c7cdd6; border-radius: 50%; }
  .role-line { margin-top: 2mm; font-weight: 700; color: #315579; }
  .contact-row { display: flex; flex-wrap: wrap; gap: 5mm; margin-top: 3mm; padding-block: 2mm; border-block: 0.25mm solid #c7cdd6; font-size: 8pt; }
  .summary strong { font-size: 10pt; }
  .summary p { margin-top: 1.5mm; color: #4d5968; }
  .core-skills h2 { font-size: 10pt; margin-bottom: 1.5mm; }
  .core-skills p { color: #4d5968; font-size: 9pt; }
  .job { border-top: 0.3mm solid #596779; padding-top: 2mm; }
  .job + .job { margin-top: 5mm; }
  .job header { display: flex; justify-content: space-between; gap: 6mm; }
  .job header p, .job time { font-size: 8.5pt; color: #4d5968; }
  .job time { flex-shrink: 0; }
  .context { margin-top: 1.5mm; color: #4d5968; }
  .highlight-list { margin: 2mm 0 0; padding-left: 4mm; }
  .highlight-list li { padding-left: 0.5mm; margin-top: 4mm; }
  .highlight-list strong { font-size: 10pt; }
  .highlight-list p { margin-top: 1mm; color: #4d5968; font-size: 10pt; line-height: 1.6; }
  .page-header { display: flex; justify-content: space-between; padding-bottom: 3mm; border-bottom: 0.3mm solid #596779; }
  .page-header strong { font-size: 12pt; }
  .page-header span, .section-context { color: #4d5968; font-size: 8.5pt; }
  .work-case-list article { padding-block: 4mm; border-bottom: 0.25mm solid #c7cdd6; }
  .work-case-list article p { margin-top: 1.5mm; color: #4d5968; }
  .work-case-list article strong { color: #202b3b; }
  .lower-grid { display: grid; grid-template-columns: 1fr; gap: 5mm; }
  .skills { border-top: 0.3mm solid #596779; }
  .skills > div { display: grid; grid-template-columns: 32mm 1fr; gap: 4mm; padding-block: 1.6mm; border-bottom: 0.25mm solid #c7cdd6; }
  .skills p { color: #4d5968; }
  .document-links p { margin-top: 2mm; color: #4d5968; }
  .education p { margin-top: 1mm; color: #4d5968; }
  footer { position: absolute; bottom: 13mm; left: 15mm; right: 15mm; display: flex; justify-content: space-between; border-top: 0.25mm solid #c7cdd6; padding-top: 2mm; color: #4d5968; font-size: 7.5pt; }
  @media screen and (max-width: 839px) {
    main { display: block; padding: 12px; }
    .sheet { width: 100%; height: auto; min-height: 297mm; margin-bottom: 16px; padding: 24px 20px 64px; overflow: visible; }
    .job header { flex-wrap: wrap; }
    .skills > div { grid-template-columns: 1fr; gap: 4px; }
    footer { left: 20px; right: 20px; bottom: 20px; }
  }
  @media print { html, body { background: #fff; } main { display: block; padding: 0; } }
</style>