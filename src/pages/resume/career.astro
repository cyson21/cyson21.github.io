---
import { experiences, profile, professionalSummary, resumeIntro } from '../../data/site';
import { careerCasePages } from '../../data/career-description';
---
<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>손찬양 경력기술서</title>
  </head>
  <body>
    <nav class="document-actions" aria-label="문서 메뉴">
      <a href="/experience/">경력·이력서</a>
      <a href="/downloads/career-description.pdf" download>경력기술서 PDF 다운로드</a>
    </nav>
    <main>
      <section class="sheet" aria-label="경력기술서 1페이지">
        <header class="masthead"><h1>{profile.name} <span>경력기술서</span></h1><p>{profile.role}</p></header>
        <div class="contact-row"><a href={profile.github}>github.com/cyson21</a><a href={`${profile.portfolio}portfolio/`}>cyson21.github.io/portfolio/</a></div>
        <section class="summary"><h2>API 개발·운영과 데이터 정합성</h2><p>{resumeIntro}</p><p>{professionalSummary}</p></section>
        <section class="experience-list" aria-labelledby="career-heading">
          <h2 id="career-heading">회사별 담당 업무</h2>
          {experiences.map(experience => (
            <article class="job">
              <header><h3>{experience.company}</h3><p>{experience.period} · {experience.role}</p></header>
              <p class="context">{experience.context}</p>
              <ul>{experience.responsibilities.map(item => <li><strong>{item.title}</strong><p>{item.description}</p></li>)}</ul>

            </article>
          ))}
        </section>
        <footer><span>손찬양 · 회사 실무 경력기술서</span><span>1 / 3</span></footer>
      </section>
      {careerCasePages.map((items, pageIndex) => (
        <section class="sheet" aria-label={`경력기술서 ${pageIndex + 2}페이지`}>
          <header class="page-header"><h2>대표 실무 문제 해결</h2><p>이엠캐스트 · B2B 리테일 교육 플랫폼</p></header>
          {items.map(item => (
            <article class="work-case">
              <h3>{item.title}</h3>
              <section><h4>문제</h4><p>{item.problem}</p></section>
              <section><h4>원인 확인</h4><p>{item.cause}</p></section>
              <section><h4>해결 선택과 이유</h4><p>{item.decision}</p></section>
              <section><h4>변경한 동작</h4><p>{item.change}</p></section>
              <section><h4>검증 근거</h4><p>{item.evidence}</p></section>
              <a class="detail-link" href={`${profile.portfolio}portfolio/#${item.anchor}`}>웹 포트폴리오에서 상세 보기</a>
            </article>
          ))}
          {pageIndex === 1 && <p class="supporting-link">개인 프로젝트의 코드·테스트 근거는 <a href={`${profile.portfolio}projects/`}>cyson21.github.io/projects/</a>에서 확인할 수 있습니다.</p>}
          <footer><span>손찬양 · 회사 실무 경력기술서</span><span>{pageIndex + 2} / 3</span></footer>
        </section>
      ))}
    </main>
  </body>
</html>
<style is:global>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #edf1f5; color: #243449; font-family: Pretendard, "Malgun Gothic", "Noto Sans KR", "Apple SD Gothic Neo", sans-serif; }
  body { font-size: 11pt; line-height: 1.55; }
  a { color: #315d88; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  a:focus-visible { outline: 2px solid #315d88; outline-offset: 4px; }
  ::selection { background: #dce7f3; color: #243449; }
  h1, h2, h3, h4, p { margin: 0; word-break: keep-all; overflow-wrap: break-word; }
  h1 { font-size: 26pt; line-height: 1.3; }
  h1 span { font-size: 17pt; font-weight: 500; }
  h2 { font-size: 15pt; line-height: 1.4; }
  h3 { font-size: 12.5pt; line-height: 1.45; }
  h4 { font-size: 10.5pt; line-height: 1.55; }
  .document-actions { max-width: 210mm; margin: 20px auto 0; display: flex; flex-wrap: wrap; gap: 20px; padding: 0 16px; }
  main { display: grid; justify-content: center; gap: 10mm; padding-block: 6mm 10mm; }
  .sheet { position: relative; width: 210mm; height: 297mm; padding: 13mm 15mm 22mm; background: #fff; break-after: page; }
  .sheet:last-child { break-after: auto; }
  .masthead p { margin-top: 2mm; color: #4b5b70; }
  .contact-row { display: flex; flex-wrap: wrap; gap: 6mm; margin-top: 3mm; padding-block: 2mm; border-block: 0.25mm solid #a7b4c4; font-size: 8.5pt; }
  .contact-row a { color: #4b5b70; }
  .summary { margin-top: 5mm; }
  .summary p { margin-top: 1.5mm; }
  .experience-list { margin-top: 5mm; }
  .job { margin-top: 3mm; border-top: 0.3mm solid #a7b4c4; padding-top: 2.5mm; }
  .job header p { margin-top: 0.5mm; color: #4b5b70; font-size: 9pt; }
  .context { margin-top: 2mm; }
  .job ul { margin: 2mm 0 0; padding-left: 4mm; }
  .job li { margin-top: 1.5mm; }
  .job li p { color: #4b5b70; font-size: 9.5pt; }
  .job li strong { font-size: 10pt; }

  .page-header { padding-bottom: 3mm; border-bottom: 0.3mm solid #a7b4c4; }
  .page-header p { margin-top: 1mm; font-size: 9pt; color: #4b5b70; }
  .work-case { margin-top: 5mm; padding-bottom: 4mm; border-bottom: 0.25mm solid #dce3eb; }
  .work-case section { margin-top: 2mm; }
  .work-case h4 { display: inline; margin-right: 2mm; }
  .work-case section p { display: inline; color: #4b5b70; }
  .detail-link { display: inline-block; margin-top: 2mm; font-size: 8.5pt; }
  .supporting-link { margin-top: 4mm; font-size: 8.5pt; color: #4b5b70; }
  footer { position: absolute; bottom: 12mm; left: 15mm; right: 15mm; display: flex; justify-content: space-between; border-top: 0.25mm solid #a7b4c4; padding-top: 2mm; font-size: 8pt; color: #4b5b70; font-variant-numeric: tabular-nums; }
  @media screen and (max-width: 839px) {
    body { font-size: 16px; line-height: 1.7; }
    main { display: block; padding: 16px; }
    .sheet { width: 100%; height: auto; padding: 24px 20px; margin-bottom: 16px; }
    h1 { font-size: 30px; } h1 span { display: block; font-size: 22px; }
    h2 { font-size: 24px; } h3 { font-size: 21px; } h4 { font-size: 16px; }
    .job li p, .job li strong, .context, .summary p { font-size: 16px; }
    .job header p, .page-header p, .detail-link, .supporting-link { font-size: 14px; }
    .contact-row { gap: 8px 16px; font-size: 14px; }
    .work-case { margin-top: 24px; padding-bottom: 24px; }
    .work-case section { margin-top: 12px; }
    footer { position: static; margin-top: 24px; font-size: 12px; }
  }
  @media print { html, body { background: #fff; } main { display: block; padding: 0; } .document-actions { display: none; } }
</style>
