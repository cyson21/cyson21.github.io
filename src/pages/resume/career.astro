---
import { experiences, profile } from '../../data/site';
import { careerPrintSheets } from '../../data/career-description';
import '../../styles/career-documents.css';
const current = experiences[0];
if (!current) throw new Error('경력기술서에는 현재 회사 경력이 필요합니다.');
---
<!doctype html>
<html lang="ko-KR">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>손찬양 | 경력기술서</title></head>
<body class="career-document"><main>
  {careerPrintSheets.map((sheet, index) => (
    <section class="sheet" aria-label={`경력기술서 ${index + 1}페이지`}>
      {index === 0 ? <>
        <header>
          <div class="document-heading"><h1>{profile.name}</h1><span class="document-kind">경력기술서</span></div>
          <p class="role">{profile.role}</p>
          <div class="contact"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>github.com/cyson21</a><a href={profile.portfolio}>cyson21.github.io</a></div>
        </header>
        <section class="career-company" aria-label="회사와 담당 범위">
          <div class="company-heading"><h2>{current.company}</h2><time class="period">{current.period}</time></div>
          <p class="job-role">{current.role} · B2B 리테일 교육 플랫폼</p>
        </section>
      </> : <header>
        <p class="continuation">손찬양 · 경력기술서</p>
        <h2 class="chapter-title">{sheet.topic}</h2>
        <p class="chapter-meta">{current.company} · {current.period} · {current.role}</p>
      </header>}
      <div class="narratives">
        {sheet.cases.map(item => (
          <article class="narrative-case" data-career-case={item.anchor}>
            <h3>{item.title}</h3><p class="technology">{item.technology}</p>
            <dl class="case-facts">
              <dt>문제</dt><dd>{item.context}</dd>
              <dt>판단</dt><dd>{item.decision}</dd>
              <dt>수행</dt><dd><ol>{item.steps.map(step => <li>{step}</li>)}</ol></dd>
              <dt>기여</dt><dd>{item.contribution}</dd>
            </dl>
          </article>
        ))}
      </div>
      {index === careerPrintSheets.length - 1 && <div class="document-links"><a href={new URL(profile.resumePath, profile.portfolio).href}>이력서 PDF</a><a href={new URL('/portfolio/cases.html', profile.portfolio).href}>실무 사례 웹 상세</a></div>}
      <footer class="page-footer"><span>손찬양 · 경력기술서</span><span>{index + 1} / {careerPrintSheets.length}</span></footer>
    </section>
  ))}
</main></body>
</html>
