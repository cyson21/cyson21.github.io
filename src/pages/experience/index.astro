---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import {
  careerPeriod,
  experiences,
  skillGroups,
} from '../../data/site';

const currentExperience = experiences[0];
if (!currentExperience) {
  throw new Error('경력·이력서 페이지에는 현재 경력 항목이 필요합니다.');
}
---

<BaseLayout
  title="경력·이력서"
  description="손찬양의 Java·Spring Boot 백엔드 실무 경력과 이력서입니다. 회사별 담당 업무와 실제 운영 문제 해결 사례를 정리했습니다."
>
  <PageIntro title="경력·이력서" description={`전체 경력 · ${careerPeriod}`} />

  <section class="section experience-section">
    <div class="container experience-layout">
      <div class="experience-list" aria-label="경력 상세">
        {experiences.map((experience) => (
          <article class="experience-entry">
            <header>
              <div>
                <p class="eyebrow">{experience.period}</p>
                <h2>{experience.company}</h2>
                <p class="role">{experience.role}</p>
              </div>
              <p class="context">{experience.context}</p>
            </header>

            <section class="responsibilities">
              <p class="responsibilities-title" role="heading" aria-level="3">주요 기여</p>
              <ul>
                {experience.responsibilities.map((responsibility) => (
                  <li>
                    <h4>{responsibility.title}</h4>
                    <p>{responsibility.description}</p>
                  </li>
                ))}
              </ul>
            </section>
            {experience === currentExperience && <div class="experience-case-next"><a class="button button--secondary" href="/portfolio/">실무 사례</a></div>}
          </article>
        ))}
      </div>

      <div class="experience-support">
        <section class="experience-support-panel" aria-labelledby="skills-title">
          <h2 id="skills-title">실무 기술 스택</h2>
          <div class="skill-groups">
            {skillGroups.map((group) => (
              <div>
                <p class="skill-label">{group.label}</p>
                <ul class="tag-list">{group.items.map((item) => <li class="tag">{item}</li>)}</ul>
              </div>
            ))}
          </div>
        </section>

        <section class="experience-support-panel resume-education" aria-labelledby="education-title">
          <h2 id="education-title">학력</h2>
          <p><strong>서울과학기술대학교</strong> <span>영어영문학 학사 · 2018 졸업</span></p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .experience-case-next{padding-top:20px;border-top:1px solid var(--line);display:flex;align-items:center;flex-wrap:wrap;gap:16px}

  .work-case-list { padding: 24px clamp(22px, 3vw, 34px); border-bottom: 1px solid var(--line-strong); }
  .work-case-list article { max-width: 820px; padding-block: 20px; }
  .work-case-list article + article { border-top: 1px solid var(--line); }
  .work-case-list h4 { margin-bottom: 12px; font-size: var(--text-lede); }
  .work-case-list p { margin-top: 8px; color: var(--ink-soft); font-size: var(--text-dense); }
  .work-case-list strong { color: var(--ink); }

  .experience-layout {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  .experience-section {
    padding-top: clamp(28px, 4vw, 48px);
  }

  .experience-list {
    display: grid;
    gap: 32px;
  }

  .experience-entry header {
    display: grid;
    grid-template-columns: minmax(0, 760px);
    gap: 14px;
    align-items: start;
    padding: clamp(22px, 3vw, 34px);
    border-bottom: 1px solid var(--line-strong);
  }

  .experience-entry header > * {
    min-width: 0;
  }

  .experience-entry h2 {
    font-size: var(--text-h2);
    overflow-wrap: anywhere;
  }

  .role {
    margin-top: 8px;
    color: var(--ink-soft);
    font-weight: 800;
  }

  .context {
    max-width: 760px;
    color: var(--ink-soft);
    font-size: var(--text-dense);
    overflow-wrap: anywhere;
  }

  .responsibilities {
    display: grid;
    gap: 16px;
    padding: 24px clamp(22px, 3vw, 34px);
  }

  .responsibilities-title {
    color: var(--ink-faint);
    font-size: var(--text-label);
    font-weight: 800;
    line-height: 1.35;
  }

  .responsibilities ul {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .responsibilities li {
    display: grid;
    gap: 5px;
    max-width: var(--reading);
    min-width: 0;
  }

  .responsibilities h4 {
    font-size: var(--text-dense);
    overflow-wrap: anywhere;
  }

  .responsibilities p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-dense);
    overflow-wrap: anywhere;
  }

  .experience-stack {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 18px;
    padding: 20px clamp(22px, 3vw, 34px) 24px;
  }

  .experience-stack > span {
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: var(--text-label);
    font-weight: 800;
  }

  .experience-support {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  .experience-support-panel {
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .skill-groups {
    display: grid;
    gap: 14px;
  }

  .skill-groups > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 18px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }

  .skill-label {
    font-size: var(--text-dense);
    font-weight: 800;
  }

  .resume-education p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 12px;
  }

  .resume-education span {
    color: var(--ink-soft);
    font-size: var(--text-dense);
  }

  @media (max-width: 959px) {
    .experience-entry header,
    .experience-stack,
    .skill-groups > div {
      grid-template-columns: 1fr;
    }

    .responsibilities,
    .experience-stack {
      gap: 12px;
    }

  }

  @media (max-width: 639px) {
    .experience-section {
      padding-bottom: 48px;
    }

    .experience-layout {
      gap: 28px;
    }

    .experience-list {
      gap: 24px;
    }

    .experience-entry header,
    .responsibilities,
    .experience-stack {
      padding-inline: 20px;
    }

    .responsibilities {
      padding-block: 20px;
    }

    .experience-stack {
      padding-top: 14px;
      padding-bottom: 20px;
    }
  }
</style>
