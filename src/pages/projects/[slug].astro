---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, ArrowUpRight, CircleAlert, CodeXml } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecisionGrid from '../../components/DecisionGrid.astro';
import CodeEvidence from '../../components/CodeEvidence.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previous: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  previous: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, previous, next }: Props = Astro.props;
const data = project.data;
await render(project);
const layerLabel: Record<string, string> = {
  unit: '단위 테스트',
  integration: '통합 테스트',
  'container-smoke': '컨테이너 테스트',
  'static-demo': '정적 데모',
  'live-demo': '공개 데모',
  cloud: '클라우드 환경',
};
const evidenceLabels = { 'ci-record': '기준 버전 CI 실행 확인', 'local-rerun': '표시된 점검일에 재실행', 'test-definition': '검사 스크립트 정의 · 실행 결과 미확인' } as const;
const domainLabels = { Backend: '백엔드', Data: '데이터', AI: 'AI' } as const;
const isStockRush = project.id === 'stockrush';
const toc = [
  ['overview', '개요'],
  ['decisions', '설계'],
  ['evidence', '코드'],
  ['verification', '검증'],
  ['scope', '범위'],
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  image={data.visual.kind === 'image' ? data.visual.src : undefined}
  imageAlt={data.visual.alt}
  article={true}
  updatedAt={data.updatedAt}
>
  <header class="project-hero">
    <div class="container">
      <div class="project-heading">
        <a class="back-link" href="/projects/"><ArrowLeft size={17} aria-hidden="true" /> 개인 프로젝트</a>
        <h1>{data.name}</h1>
        <p class="project-lede">{isStockRush ? data.listSummary : data.summary}</p>
        <div class="button-row project-actions">
          <p class="project-context">{data.period} · {domainLabels[data.domain]}</p>
          {!isStockRush && <p class="project-context">{data.role.replace('개인 프로젝트 · ', '')}</p>}
          {data.links.github && <a class="project-repository" href={data.links.github} target="_blank" rel="noreferrer" aria-label={`${data.name} GitHub 저장소 새 창에서 열기`}><CodeXml size={17} aria-hidden="true" /> GitHub 저장소 <ArrowUpRight size={15} aria-hidden="true" /></a>}
          {data.links.demo && <a class="button button--secondary" href={data.links.demo} target="_blank" rel="noreferrer" aria-label={`${data.name} 데모 새 창에서 열기`}>데모 열기 <ArrowUpRight size={17} aria-hidden="true" /></a>}
          {data.publicationState === 'case-study-only' && <span class="scope-badge"><CircleAlert size={16} aria-hidden="true" /> 문서만 공개</span>}
        </div>
      </div>
    </div>
  </header>

  <div class="container project-layout">
    <nav class="project-toc no-print" aria-label={`${data.name} 목차`}>
      {toc.map(([id, label], index) => <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined}>{label}</a>)}
    </nav>

    <article class="project-content">
      <section id="overview" class:list={['project-section', { 'overview--compact': isStockRush }]} tabindex="-1">
        {isStockRush ? (
          <>
            <h2>재고를 예약한 뒤 결제가 실패하면 어떻게 복구할까?</h2>
            <p class="section-lede">주문·재고·결제가 서로 다른 서비스에 있어 이미 완료된 단계를 한 번에 되돌릴 수 없습니다. 결제가 실패하면 주문 Saga가 재고 예약을 해제하고, 발행하지 못한 이벤트는 Outbox에 보관합니다.</p>
            <div class="stockrush-role">
              <h3>맡은 범위</h3>
              <p>주문 Saga, 서비스별 Outbox 발행기, 실패 이벤트를 다시 보내는 관리자 API를 구현했습니다. 서비스별 PostgreSQL 스키마를 구성하고, 게이트웨이의 OIDC/JWT 인증과 주문 서비스의 소유권 검사를 분리했습니다.</p>
            </div>
          </>
        ) : (
          <>
            <h2>해결한 문제와 담당 역할</h2>
            <p class="section-lede">{data.problem}</p>
            <div class="responsibility-list">
              {data.responsibilities.map((item) => <p>{item}</p>)}
            </div>
            <div class="overview-rules">
              <h3>핵심 요구사항</h3>
              <ul class="protection-list">
                {data.protectionRules.map((rule) => <li><strong>{rule}</strong></li>)}
              </ul>
            </div>
          </>
        )}
      </section>

      <div class="visual-wrap">
        <ProjectVisual name={data.name} visual={data.visual} flow={data.flow.normal} />
      </div>

      <section id="decisions" class="project-section project-section--wide" tabindex="-1">
        <h2>기술 선택과 이유</h2>
        <DecisionGrid items={data.decisions} />
        <ul class="tag-list project-stack" aria-label={`${data.name} 기술 스택`}>{data.stack.map((item) => <li class="tag">{item}</li>)}</ul>
      </section>

      <section id="evidence" class="project-section project-section--wide" tabindex="-1">
        <h2>주요 구현과 관련 테스트</h2>
        <CodeEvidence items={data.codeEvidence} />
      </section>

      <section id="verification" class="project-section project-section--wide" tabindex="-1">
        <h2>테스트 결과</h2>
        <p class="verification-scope">{data.evidenceReview.scope}</p>
        <div class="verification-results">
          {data.verification.map((item) => (
            <article class="verification-result">
              <h3>{item.title}</h3>
              <p class="verification-outcome">{item.result}</p>
              <details class="verification-details">
                <summary>테스트 방법과 근거</summary>
                <p class="evidence-status">{layerLabel[item.layer]} · {evidenceLabels[item.evidenceStatus]}</p>
                <p>{item.method}</p>
                <ul class="verification-sources" aria-label="이 결과의 근거">
                  {item.sources.map((source) => (
                    <li>
                      <a href={source.url} target="_blank" rel="noreferrer" aria-label={`${source.label} 근거 새 창에서 열기`}>
                        <span>{source.label}</span>
                        <ArrowUpRight size={14} aria-hidden="true" />
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </article>
          ))}
        </div>
        <div class="evidence-review">
          <p>근거 대조 <time>{data.evidenceReview.checkedAt}</time></p>
          <a href={data.evidenceReview.sourceUrl} target="_blank" rel="noreferrer" aria-label="소스 기준 버전 새 창에서 열기">소스 기준 버전 <ArrowUpRight size={14} aria-hidden="true" /></a>
          <a href={data.evidenceReview.ciUrl} target="_blank" rel="noreferrer" aria-label="CI 실행 기록 새 창에서 열기">CI 실행 기록 ({data.evidenceReview.ciRunDate}) <ArrowUpRight size={14} aria-hidden="true" /></a>
        </div>
      </section>

      <section id="scope" class="project-section scope-grid" tabindex="-1">
        <h2>프로젝트 범위</h2>
        <div>
          <h3>검증 한계와 미구현 범위</h3>
          <ul class="rule-list">{data.limitations.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h3>향후 개선</h3>
          <ul class="rule-list">{data.next.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      {(data.links.adr || data.links.design || data.links.testReport) && (
        <section class="project-resources" aria-label="프로젝트 외부 자료">
          <p>관련 자료</p>
          <div>
            {data.links.adr && <a href={data.links.adr} target="_blank" rel="noreferrer" aria-label={`${data.name} 설계 결정 기록 새 창에서 열기`}>설계 결정 기록 <ArrowUpRight size={15} aria-hidden="true" /></a>}
            {data.links.design && <a href={data.links.design} target="_blank" rel="noreferrer" aria-label={`${data.name} 설계 문서 새 창에서 열기`}>설계 문서 <ArrowUpRight size={15} aria-hidden="true" /></a>}
            {data.links.testReport && <a href={data.links.testReport} target="_blank" rel="noreferrer" aria-label={`${data.name} 테스트 자료 새 창에서 열기`}>테스트 자료 <ArrowUpRight size={15} aria-hidden="true" /></a>}
          </div>
        </section>
      )}
    </article>

    {(previous || next) && (
      <nav class="project-neighbors" aria-label="이전·다음 프로젝트">
        {previous && (
          <a href={`/projects/${previous.id}/`}>
            <span class="neighbor-label"><ArrowLeft size={16} aria-hidden="true" /> 이전 프로젝트</span>
            <strong>{previous.data.name}</strong>
          </a>
        )}
        {next && (
          <a href={`/projects/${next.id}/`}>
            <span class="neighbor-label"><ArrowRight size={16} aria-hidden="true" /> 다음 프로젝트</span>
            <strong>{next.data.name}</strong>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.project-toc a[href^="#"]'));
  const sections = sectionLinks.flatMap((link) => {
    const section = document.getElementById(link.hash.slice(1));
    return section ? [section] : [];
  });

  const setCurrent = (id: string) => {
    sectionLinks.forEach((link) => {
      const active = link.hash === `#${id}`;
      if (active) {
        link.setAttribute('aria-current', 'location');
      } else link.removeAttribute('aria-current');
    });
  };

  const focusFragment = () => {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;
    setCurrent(id);
    window.requestAnimationFrame(() => target.focus({ preventScroll: true }));
  };

  window.addEventListener('hashchange', focusFragment);
  focusFragment();

  const observer = new IntersectionObserver((entries) => {
    const visible = entries
      .filter((entry) => entry.isIntersecting)
      .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
    if (visible?.target.id) setCurrent(visible.target.id);
  }, { rootMargin: '-18% 0px -68% 0px', threshold: [0, 0.1] });
  sections.forEach((section) => observer.observe(section));
</script>

<style>
  .back-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    margin-bottom: 42px;
    color: var(--ink-soft);
    font-size: 16px;
    font-weight: 800;
  }

  .project-heading h1 {
    max-width: 950px;
    font-size: var(--text-h1);
  }

  .project-lede {
    max-width: min(760px, 40ic);
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: var(--text-lede);
    line-height: 1.6;
  }

  .scope-badge {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid var(--amber);
    border-radius: 4px;
    background: var(--amber-soft);
    color: var(--amber);
    font-size: var(--text-dense);
    font-weight: 800;
  }

  .project-content {
    min-width: 0;
  }

  .visual-wrap {
    min-width: 0;
    margin-bottom: 64px;
  }

  .project-section {
    width: min(100%, var(--reading));
    padding-block: 0 64px;
    scroll-margin-top: calc(var(--header-height) + 25px);
  }

  .project-section + .project-section {
    padding-top: 6px;
  }

  .project-section--wide {
    width: 100%;
  }

  .project-section h2 {
    margin-bottom: 20px;
    font-size: var(--text-h2);
  }

  .section-lede {
    max-width: min(760px, 40ic);
    margin-bottom: 24px;
    color: var(--ink-soft);
    font-size: var(--text-lede);
    line-height: 1.6;
  }

  .responsibility-list {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .responsibility-list > div {
    padding-block: 16px;
    border-bottom: 1px solid var(--line-strong);
  }

  .responsibility-list > p {
    position: relative;
    padding: 16px 0 16px 24px;
    border-bottom: 1px solid var(--line-strong);
  }

  .responsibility-list > p::before {
    position: absolute;
    top: 1.85em;
    left: 2px;
    width: 8px;
    height: 2px;
    background: var(--blue);
    content: "";
  }

  .overview-rules {
    margin-top: 40px;
  }

  .overview-rules h3 {
    margin-bottom: 16px;
  }

  .protection-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .protection-list li {
    position: relative;
    padding: 16px 0 16px 24px;
    border-bottom: 1px solid var(--line-strong);
  }

  .protection-list li::before {
    position: absolute;
    top: 1.85em;
    left: 2px;
    width: 8px;
    height: 2px;
    background: var(--blue);
    content: "";
  }

  .protection-list strong {
    font-size: var(--text-body);
  }

  .scope-grid {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .scope-grid:last-child {
    padding-bottom: 0;
  }

  .scope-grid > h2 {
    grid-column: 1 / -1;
    margin-bottom: -8px;
  }

  .scope-grid > div {
    padding: 24px;
    border-top: 4px solid var(--amber);
    background: var(--amber-soft);
  }

  .scope-grid > div:last-child {
    border-top-color: var(--blue);
    background: var(--blue-soft);
  }

  .scope-grid h3 {
    margin-bottom: 16px;
    font-size: var(--text-h3);
  }

  .scope-grid .rule-list {
    color: var(--ink-soft);
    font-size: var(--text-dense);
  }

  .project-resources {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .project-resources > p {
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: var(--text-label);
    font-weight: 800;
  }

  .project-resources > div {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .project-resources a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 5px;
    font-size: 16px;
    font-weight: 800;
  }

  .project-neighbors {
    max-width: var(--reading);
    margin-top: 24px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  .project-neighbors a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: 12px;
    padding-block: 6px;
    color: var(--blue);
    text-decoration: none;
  }

  .project-neighbors a strong {
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project-neighbors a:hover strong {
    text-decoration-thickness: 2px;
  }

  .neighbor-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--pagination-label-copy, var(--ink-faint));
    font-family: var(--sans);
    font-size: var(--text-label);
    font-weight: 800;
  }

  .neighbor-label svg {
    flex: none;
  }

  @media (max-width: 959px) {
    .project-section {
      scroll-margin-top: calc(var(--header-height) + 24px);
    }

    .visual-wrap {
      margin-bottom: 56px;
    }
  }

  @media (max-width: 639px) {
    .project-heading h1 {
      overflow-wrap: anywhere;
    }

    .visual-wrap {
      margin-bottom: 42px;
    }

    .project-resources {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .project-hero {
    padding-block: clamp(16px, 3vw, 38px) 18px;
    border-bottom: 0;
  }

  .project-hero .back-link {
    margin-bottom: 6px;
  }

  .project-hero .project-lede {
    max-width: 44ic;
    margin-top: 10px;
  }

  .project-hero .project-actions {
    align-items: center;
    gap: 4px 18px;
    margin-top: 5px;
  }

  .project-context,
  .project-repository {
    color: var(--ink-soft);
    font-size: var(--text-dense);
    font-weight: 700;
  }

  .project-context {
    color: var(--project-meta-copy, var(--ink-faint));
  }

  .project-repository {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    text-underline-offset: 4px;
  }

  .project-layout {
    padding-bottom: 24px;
  }

  .project-toc {
    margin-bottom: clamp(22px, 4vw, 40px);
    padding-block: 0;
    border-block: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(12px, 4vw, 32px);
  }

  .project-toc a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-bottom: 2px solid transparent;
    text-decoration: none;
  }

  .project-toc a:hover,
  .project-toc a[aria-current='location'] {
    border-bottom-color: currentColor;
    color: var(--blue);
  }

  .overview--compact {
    width: min(100%, 54ic);
    padding-bottom: clamp(20px, 3vw, 32px);
  }

  .overview--compact > h2 {
    margin-bottom: 12px;
  }

  .overview--compact .section-lede {
    max-width: none;
    margin-bottom: 16px;
    font-size: var(--text-body);
  }

  .stockrush-role {
    padding-left: 14px;
    border-left: 2px solid var(--line-strong);
  }

  .stockrush-role h3 {
    margin-bottom: 4px;
  }

  .stockrush-role p {
    color: var(--ink-soft);
  }

  .project-stack {
    margin-top: 20px;
  }

  .verification-scope,
  .verification-results,
  .evidence-review {
    max-width: min(100%, var(--reading));
  }

  .verification-scope {
    margin-bottom: 14px;
    color: var(--ink-soft);
    font-size: var(--text-dense);
  }

  .verification-result {
    padding-block: 18px 12px;
    border-top: 1px solid var(--line);
  }

  .verification-result h3 {
    margin-bottom: 6px;
    font-size: var(--text-h3);
    overflow-wrap: anywhere;
  }

  .verification-outcome {
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .verification-details {
    color: var(--ink-soft);
    font-size: var(--text-dense);
  }

  .verification-details summary {
    width: fit-content;
    min-height: 44px;
    padding-block: 10px;
    color: var(--blue);
    font-weight: 750;
    cursor: pointer;
  }

  .evidence-status {
    margin-bottom: 5px;
    color: var(--ink-faint);
    font-size: var(--text-label);
    font-weight: 750;
  }

  .evidence-review,
  .verification-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 16px;
    color: var(--ink-soft);
    font-size: var(--text-dense);
  }

  .evidence-review {
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .evidence-review a,
  .verification-sources a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    color: var(--blue);
    text-underline-offset: 4px;
  }

  .evidence-review svg,
  .verification-sources svg {
    flex: 0 0 auto;
  }

  .verification-sources a span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .verification-sources > li {
    min-width: 0;
    max-width: 100%;
  }

  .verification-sources {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
