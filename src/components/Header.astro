---
import { renderHeader } from '../lib/site-navigation.mjs';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
---
<link rel="stylesheet" href="/portfolio/assets/site-chrome.css" />
<Fragment set:html={renderHeader(currentPath)} />
<script is:inline type="module" src="/portfolio/assets/site-chrome.js"></script>
