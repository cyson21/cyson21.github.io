---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 2 | 3;
  compact?: boolean;
}

const { project, headingLevel = 3, compact = false }: Props = Astro.props;
const data = project.data;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const detailHref = `/projects/${project.id}/`;
const domainLabels = { Backend: '백엔드', Data: '데이터', AI: 'AI' } as const;
---

<article class:list={['project-row', { 'project-row--compact': compact }]}>
  <div class="project-main">
    <div class="project-copy">
      <div class="project-title-line">
        <Heading>
          {compact ? data.name : <a href={detailHref}><span>{data.name}</span> <ArrowRight size={19} aria-hidden="true" /></a>}
        </Heading>
        <div class="project-status">
          <span class="domain">{domainLabels[data.domain]}</span>
          {data.publicationState === 'case-study-only' && <span class="case-study">문서만 공개</span>}
        </div>
      </div>
      <p class="project-summary">{compact ? data.summary : data.listSummary}</p>
      {compact && data.cardEvidence && (
        <dl class="project-card-evidence">
          <div>
            <dt>핵심 구현</dt>
            <dd>{data.cardEvidence.implementation}</dd>
          </div>
          <div>
            <dt>확인 결과</dt>
            <dd>{data.cardEvidence.result}</dd>
          </div>
        </dl>
      )}
      <div class="project-footnote">
        <ul class="tag-list" aria-label={`${data.name} 기술`}>
          {data.stack.slice(0, 5).map((item) => <li class="tag">{item}</li>)}
        </ul>
        {compact && <span class="project-period">{data.period}</span>}
      </div>
      {compact && (
        <div class="project-links project-links--compact">
          <a href={`/projects/${project.id}/`} aria-label={`${data.name} 프로젝트 상세 보기`}>{data.name} 상세 <ArrowRight size={16} aria-hidden="true" /></a>
          {data.links.github && <a href={data.links.github} target="_blank" rel="noreferrer" aria-label={`${data.name} GitHub 저장소 새 창에서 열기`}>GitHub 저장소 <ArrowUpRight size={15} aria-hidden="true" /></a>}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .project-row {
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }

  .project-row--compact:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project-main,
  .project-copy {
    min-width: 0;
  }

  .project-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .project-title-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .project-title-line h2 {
    min-width: 0;
    max-width: 100%;
    font-size: var(--text-h2);
  }

  .project-title-line h3 {
    font-size: var(--text-h3);
  }

  .project-title-line :is(h2, h3) a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    text-underline-offset: 5px;
  }

  .project-title-line a:hover,
  .project-title-line a:focus-visible {
    color: var(--blue);
    text-decoration: underline;
  }

  .project-title-line a span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .project-title-line a svg {
    flex: 0 0 auto;
  }

  .project-status {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    order: -1;
    justify-content: flex-start;
    gap: 6px;
  }

  .domain,
  .case-study {
    padding: 3px 7px;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: var(--text-label);
    font-weight: 800;
  }

  .case-study {
    border-color: var(--amber);
    background: var(--amber-soft);
    color: var(--amber);
  }

  .project-summary {
    max-width: 760px;
    color: var(--ink-soft);
  }

  .project-card-evidence {
    display: grid;
    gap: 0;
    margin: 2px 0 0;
    border-top: 1px solid var(--line);
  }

  .project-card-evidence > div {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 14px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .project-card-evidence dt {
    color: var(--green);
    font-family: var(--sans);
    font-size: var(--text-label);
    font-weight: 800;
  }

  .project-card-evidence dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-dense);
  }

  .project-footnote {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
  }

  .project-period {
    flex: 0 0 auto;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: var(--text-code);
    font-variant-numeric: tabular-nums;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 5px;
  }

  .project-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 4px;
    padding-inline: 4px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 800;
  }

  .project-links--compact {
    margin-top: -2px;
  }

  .project-row--compact {
    display: block;
    padding-block: 32px;
  }

  .project-row--compact .tag-list {
    display: none;
  }

  @media (max-width: 639px) {
    .project-status {
      justify-content: flex-start;
    }

    .project-footnote {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }

    .project-row--compact .project-footnote {
      margin-top: 2px;
    }

    .project-card-evidence > div {
      grid-template-columns: 1fr;
      gap: 4px;
      padding-block: 10px;
    }

    .project-card-evidence dd,
    .project-summary {
      overflow-wrap: anywhere;
    }
  }
</style>
